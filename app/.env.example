# Copier en .env.local (non versionné). Ce sont des valeurs PUBLIQUES, pas des secrets.
# URL de l'Edge Function : https://<projet>.supabase.co/functions/v1/suggest
EXPO_PUBLIC_API_URL=
# Clé "anon" / publishable du projet Supabase
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Clés publiques RevenueCat (Project settings → API keys)
EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=
